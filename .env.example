# EXAMPLE ONLY - placeholders. Copy to .env and fill in real values yourself.
# Claude Code must never read .env (see CLAUDE.md and .claude/settings.json).
# Variable list is a starting point; align with app/config as it is built.

# Gemini
GOOGLE_API_KEY=
# Model Armor (Google Cloud, asia-south1)
GOOGLE_CLOUD_PROJECT=
MODEL_ARMOR_TEMPLATE=
